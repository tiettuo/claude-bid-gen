# bid-gen 环境变量模板
# 用法：cp .env.example .env  然后填入真实 API Key

# ─── 运行时根目录 ───────────────────────────────────
# 脚本/提示词中所有 $BID_GEN_HOME 引用都来自这里
# 默认会回落到脚本相对路径（scripts/ 的上级目录），通常不用显式设置
# BID_GEN_HOME=/path/to/bid-gen

# ─── LLM API Keys（按需配置，未配置的模型在 variants 分配时跳过）───
GLM_API_KEY=                  # 智谱 https://open.bigmodel.cn/  GLM-4.6 + GLM-OCR
DEEPSEEK_API_KEY=             # https://platform.deepseek.com/  DeepSeek-V3.2
DASHSCOPE_API_KEY=            # 阿里百炼 https://dashscope.console.aliyun.com/  Qwen3-Max + Qwen-VL-Max
MOONSHOT_API_KEY=             # https://platform.moonshot.cn/   Kimi-K2.5（temperature 强制 0.6）
MINIMAX_API_KEY=              # https://api.minimax.chat/       MiniMax-M2.5
ARK_API_KEY=                  # 火山方舟豆包（当前 disabled，充值后改 configs/bid_llm_config.json）

# ─── 可选 ────────────────────────────────────────
# LLM_ENV_FILE=               # 自定义 .env 路径（默认从 ~/.env 加载）
