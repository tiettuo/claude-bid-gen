{
  "_comment": "投标文件提取阶段 - 视觉大模型 OCR 配置。分层触发：前三类关键词强制走视觉（即便 pdfplumber 抽到字），后四类仅扫描页触发。",

  "models": {
    "qwen_vl": {
      "display_name": "通义千问 Qwen3-VL-Flash",
      "endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model_name": "qwen3-vl-flash",
      "api_key_env": "DASHSCOPE_API_KEY",
      "max_tokens": 4000,
      "supports_openai_compat": true,
      "notes": "速度优先：qwen3-vl-flash 每页耗时目标 <5s，中文版面能力较 max 略降；若质量下降明显可回滚 qwen-vl-max-latest"
    },
    "glm_ocr": {
      "display_name": "智谱 GLM-OCR（layout_parsing）",
      "endpoint": "https://open.bigmodel.cn/api/paas/v4",
      "model_name": "glm-ocr",
      "api_key_env": "GLM_API_KEY",
      "api_key_env_alt": "LLM_ZHIPU_KEY",
      "notes": "兜底版面解析，不走 OpenAI 兼容接口，走 zai SDK 的 layout_parsing 端点"
    },
    "glm_ocr_local": {
      "display_name": "GLM-OCR 本地（Ollama）",
      "local": true,
      "ollama_url": "http://127.0.0.1:11434/api/chat",
      "model_name": "glm-ocr:latest",
      "num_ctx": 16384,
      "notes": "离线兜底：云端全部失败时调本地 Ollama，M4 Mac ~1.7s/页，无需网络"
    }
  },

  "fallback_order": ["qwen_vl", "glm_ocr_local"],

  "category_routing": {
    "_comment": "Qwen-VL 为主（全场景），glm_ocr_local 离线兜底",
    "table_dense": "qwen_vl",
    "text_dense": "qwen_vl"
  },

  "retry": {
    "max_attempts": 2,
    "backoff_seconds": 3,
    "timeout_seconds": 120,
    "_per_model_concurrency_comment": "单个视觉模型的并发请求上限。总并发 = 本值 × 可用模型数。大 PDF(数百页)提速主要靠它;若触发限流(429)可调小。",
    "per_model_concurrency": 4
  },

  "render_dpi": 300,

  "trigger_policy": {
    "_comment": "强制触发 = 命中即视觉（即便 pdfplumber 抽到字）；扫描页触发 = 仅该页是扫描图且命中才走视觉。",
    "force_categories": ["disqualify", "blind_format", "scoring", "outline"],
    "scanned_only_categories": ["tech_core", "key_difficult"]
  },

  "keywords": {
    "disqualify": {
      "desc": "废标/否决条款 - 漏掉一条整份废",
      "terms": [
        "否决投标", "否决其投标", "予以否决",
        "废标", "作废标处理", "按废标处理",
        "无效投标", "投标无效", "视为无效",
        "重大偏差", "实质性偏差", "不实质响应",
        "不予接受", "不予受理", "不得参加",
        "一票否决", "直接否决"
      ]
    },
    "blind_format": {
      "desc": "暗标/排版/装订 - 格式违反即当场废。strong_terms 单独触发；weak_terms 仅当同页有 strong 命中才记入",
      "strong_terms": [
        "暗标", "技术暗标", "技术标暗标",
        "不得出现", "不得体现", "不得标注", "不得包含",
        "页边距", "字体", "字号", "行距",
        "投标人标识", "徽标", "LOGO",
        "骑马订", "骑缝章", "胶装", "线装",
        "密封要求", "密封袋"
      ],
      "weak_terms": [
        "投标人名称", "公司名称", "单位名称",
        "公章", "签字", "盖章",
        "标识", "标记", "明标",
        "封面", "封皮", "装订", "幅面", "页码",
        "A4", "A3", "横向", "纵向",
        "正本", "副本", "电子版", "份数",
        "彩色", "黑白", "单色打印", "密封"
      ]
    },
    "outline": {
      "desc": "施组编制大纲/编制要求 - 合格制下事实上的章节锚点；评分制下也是必含框架",
      "terms": [
        "施工组织设计编制要求", "施工组织设计编制大纲",
        "施工组织设计的编制", "施工组织总设计",
        "施组编制", "编制内容", "编制要点",
        "主要技术内容", "主要内容包括",
        "技术标准和要求", "技术标准与要求",
        "技术规范书", "技术规范",
        "投标文件构成", "投标文件组成",
        "施工组织设计应包括", "施工组织设计应包含",
        "施工组织设计内容"
      ]
    },
    "scoring": {
      "desc": "评分办法 - 决定得分命脉。strong_terms 单独触发；weak_terms 仅当同页有 strong 命中才记入",
      "strong_terms": [
        "评分办法", "评分标准", "评分细则", "评分表",
        "评标办法", "评标方法", "评标标准", "评标细则",
        "综合评分", "综合评估", "最低评标价", "经评审的最低",
        "评审因素", "评审要素", "评审内容",
        "分值", "满分", "权重",
        "技术分", "技术得分"
      ],
      "weak_terms": [
        "评标委员会",
        "打分", "得分", "加分", "扣分",
        "技术部分", "技术评审",
        "商务分", "商务部分", "价格分", "占比"
      ]
    },
    "tech_core": {
      "desc": "技术方案核心要求 - 章节内容来源",
      "terms": [
        "技术要求", "技术规格", "技术规范", "技术标准",
        "施工方案", "施工组织设计", "施工方法", "施工工艺",
        "施工进度", "工期", "计划工期", "总工期", "里程碑",
        "质量要求", "质量目标", "质量标准", "质量保证",
        "安全要求", "安全目标", "安全文明施工",
        "环保要求", "环境保护", "水土保持", "扬尘", "噪声",
        "人员配备", "项目经理", "技术负责人", "持证",
        "机械设备", "主要设备", "设备清单", "仪器仪表",
        "材料要求", "主要材料", "供应计划",
        "应急预案", "应急措施", "风险控制"
      ]
    },
    "key_difficult": {
      "desc": "重点难点/创新 - 高分项",
      "terms": [
        "重点难点", "工程重难点", "难点分析",
        "关键工序", "关键线路", "关键节点",
        "新技术", "新工艺", "新材料", "新设备", "四新技术",
        "BIM", "智慧工地", "信息化", "绿色施工",
        "合理化建议", "优化建议", "创新点"
      ]
    }
  },

  "vision_prompt": "你是招标文件版面解析助手。请把这一页完整识别为 Markdown 格式，严格遵守：\n1. 忠实复原原文，一个字都不要改写、总结或推测。\n2. 表格必须用标准 Markdown 表格语法输出（| 分隔 + 表头下划线），评分表/分值表/偏离表尤其重要，每一行每一列都要对应。\n3. 各级标题用 #/##/### 标注层级，正文用普通段落，列表用 - 或数字编号。\n4. 如果页面包含印章、手写签名、图片等非文字内容，用 [印章] [签名] [图片描述] 占位，不要尝试编造内容。\n5. 如果某处识别不清，用 [?] 标注而不是猜测。\n只输出 Markdown 文本本身，不要加任何解释说明。"
}
