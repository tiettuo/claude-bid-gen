  "retry": {
    "max_attempts": 3,
    "backoff_seconds": 30,
    "timeout_seconds": 180
  },
  "default_model": "deepseek_chat",
  "fallback_order": [
    "deepseek_chat",
    "sf_deepseek",
    "glm",
    "kimi",
    "minimax_m27"
  ],
  "default_temperature": 0.6,
  "temperature_variants": [
    0.5,
    0.7,
    0.9
  ],
  "_max_concurrency_note": "按厂商(endpoint 派生)分闸,非模型名。zhipu=智谱GLM dashscope=阿里Qwen siliconflow=硅基流动 moonshot=Kimi",
  "max_concurrency": {
    "default": 3,
    "siliconflow": 6,
    "zhipu": 1,
    "dashscope": 1,
    "minimax": 2,
    "127.0.0.1:8080": 1,
    "deepseek": 6
