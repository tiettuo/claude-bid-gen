{
  "_comment": "投标文件批量生成 - 多模型客户端配置。API Key 从环境变量读取，建议配置到 ~/.env 或系统环境。",
  "models": {
    "glm": {
      "display_name": "智谱 GLM-4.6",
      "endpoint": "https://open.bigmodel.cn/api/paas/v4",
      "model_name": "glm-4.6",
      "api_key_env": "GLM_API_KEY",
      "max_tokens": 8000,
      "output_char_cap": 5500,
      "supports_openai_compat": true,
      "extra_body": {
        "thinking": {
          "type": "disabled"
        }
      },
      "notes": "中文公文能力强；GLM-4.6 默认自动判断是否推理，extra_body 强制关",
      "writer_role": "data_preferred"
    },
    "deepseek": {
      "display_name": "DeepSeek-V4-Flash",
      "endpoint": "https://api.deepseek.com/v1",
      "model_name": "deepseek-v4-flash",
      "api_key_env": "DEEPSEEK_API_KEY",
      "max_tokens": 16000,
      "output_char_cap": 8000,
      "supports_openai_compat": true,
      "notes": "1M context(够装整本招标),返回 reasoning_content(与 content 共享 max_tokens=16000,client 已做溢出 fail-fast);输入 $0.14/1M tokens;输出 $0.28/1M。提取/翻译场景专用（需吞整本招标）。 [2026-05-20实测]单次约8200中文字,output_char_cap由12000校准为8000。 [2026-09实测]加 extra_body thinking=disabled 可完全关掉 reasoning_content(实测 248→0 字符),避免与正文共享 max_tokens 触发\"推理占满\"fail-fast 白跑一轮;写作/合成场景必须关,需整本招标吞入的提取场景如需推理可单独覆盖。",
      "extra_body": {
        "thinking": {
          "type": "disabled"
        }
      }
    },
    "deepseek_chat": {
      "display_name": "DeepSeek-V3-Chat",
      "endpoint": "https://api.deepseek.com/v1",
      "model_name": "deepseek-chat",
      "api_key_env": "DEEPSEEK_API_KEY",
      "max_tokens": 8000,
      "output_char_cap": 5500,
      "supports_openai_compat": true,
      "notes": "v3 chat 路径，64K 上下文，写作场景专用。写作单章 prompt ~5K 字够用，无需 1M context；风格更成熟稳定。"
    },
    "qwen": {
      "display_name": "通义千问 Qwen3-Max",
      "endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model_name": "qwen3-max",
      "api_key_env": "DASHSCOPE_API_KEY",
      "max_tokens": 8000,
      "output_char_cap": 5500,
      "supports_openai_compat": true,
      "disabled": true,
      "notes": "字数严重不足(66-68%)，已禁用。测试替代方案 qwen35（Qwen3.5-Plus）"
    },
    "qwen35": {
      "display_name": "通义千问 Qwen3.5-Plus",
      "endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model_name": "qwen3.5-plus",
      "api_key_env": "DASHSCOPE_API_KEY",
      "max_tokens": 8000,
      "output_char_cap": 5500,
      "supports_openai_compat": true,
      "writer_role": "system_only",
      "notes": "替代 qwen3-max；实测81%字数达成率（vs 69%），仅用于制度管理类章节和兜底，writer_role=system_only 阻止进入核心章节"
    },
    "kimi": {
      "display_name": "月之暗面 Kimi-K2.6",
      "endpoint": "https://api.moonshot.cn/v1",
      "model_name": "kimi-k2.6",
      "api_key_env": "MOONSHOT_API_KEY",
      "max_tokens": 8000,
      "output_char_cap": 5500,
      "supports_openai_compat": true,
      "force_temperature": 0.6,
      "extra_body": {
        "thinking": {
          "type": "disabled"
        }
      },
      "notes": "长文档一致性好；kimi-k2.6 温度不可变强制 0.6；extra_body 关深度思考。2026-09 实测 kimi-k2.5 已下线(404 model_not_found)，账号可用:k2.6 / k2.7-code / k3",
      "writer_role": "mgmt_preferred"
    },
    "minimax": {
      "display_name": "MiniMax-M2.5",
      "endpoint": "https://api.minimaxi.com/v1",
      "model_name": "MiniMax-M2.5",
      "api_key_env": "MINIMAX_API_KEY",
      "max_tokens": 8000,
      "output_char_cap": 5000,
      "supports_openai_compat": true,
      "disabled": true,
      "extra_body": {
